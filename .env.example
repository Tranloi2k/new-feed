# Copy to .env.local: cp .env.example .env.local

# Server-side (Next rewrites, Server Actions, getApiUrl on server)
API_GATEWAY_URL=http://localhost:8080
INTERNAL_API_URL=http://localhost:8080

# Production only, when FE and API use sibling subdomains (for example
# app.example.com and api.example.com). Leave unset on localhost.
# AUTH_COOKIE_DOMAIN=.example.com

# Browser API base (optional — omit to use same-origin via Next rewrites)
# NEXT_PUBLIC_API_URL=http://localhost:8080

# GraphQL — same-origin paths (recommended; cookies via Next rewrites)
NEXT_PUBLIC_GRAPHQL_POST_URL=/graphql/post
NEXT_PUBLIC_GRAPHQL_COMMENT_URL=/graphql/comment

# Or point directly at API Gateway:
# NEXT_PUBLIC_GRAPHQL_POST_URL=http://localhost:8080/graphql/post
# NEXT_PUBLIC_GRAPHQL_COMMENT_URL=http://localhost:8080/graphql/comment

# WebSocket / Socket.IO (must reach API Gateway; no WS rewrite in Next).
# On a forwarded/HTTPS frontend, use the public wss:// / https:// gateway URL;
# localhost here points to the viewer's machine, not the remote workspace.
NEXT_PUBLIC_WS_COMMENT_URL=ws://localhost:8080/graphql/comment
NEXT_PUBLIC_WS_NOTIFICATION_URL=http://localhost:8080
NEXT_PUBLIC_WS_CHAT_URL=http://localhost:3006

# NextAuth — required; use a long random string in production
AUTH_SECRET=change-me-to-a-long-random-secret
